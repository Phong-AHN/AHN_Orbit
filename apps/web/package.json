{
  "name": "@orbit/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "//build": "Every @orbit/* package except @orbit/ui resolves to dist/, so the workspace dependencies must be compiled before Next can find them. `^...` selects this package's dependencies and not this package, which is what makes it safe to call from the build script of the package itself. Vercel builds only this app, so without this its `next build` fails on 'Can't resolve @orbit/core'.",
    "build": "pnpm --filter @orbit/web^... build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@orbit/auth": "workspace:*",
    "@orbit/config": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/db": "workspace:*",
    "@orbit/notifications": "workspace:*",
    "@orbit/observability": "workspace:*",
    "@orbit/providers": "workspace:*",
    "@orbit/queue": "workspace:*",
    "@orbit/rbac": "workspace:*",
    "@orbit/storage": "workspace:*",
    "@orbit/ui": "workspace:*",
    "firebase": "^12.17.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
