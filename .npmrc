# Prisma's CLI shells out to `pnpm add @prisma/client` during `generate` when it
# cannot confirm the client is present. At a workspace root pnpm refuses that
# without -w, so generate fails even though the package is installed. Allowing
# the root add makes the check a no-op instead of a hard error.
ignore-workspace-root-check=true

# Keep the store deterministic across the web app and the worker image.
strict-peer-dependencies=false
auto-install-peers=true
