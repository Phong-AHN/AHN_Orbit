# ─────────────────────────────────────────────────────────────────────────────
# AHN Orbit — environment configuration (SRS §45)
#
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every variable below is validated by a zod schema at process boot
# (packages/config) — a missing or malformed value fails the deploy, not the
# first request that needs it.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=development                       # development | staging | production
APP_URL=http://localhost:3000
LOG_LEVEL=debug                           # trace | debug | info | warn | error | fatal

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL goes through the connection pooler (PgBouncer / RDS Proxy /
# Neon pooled endpoint). DIRECT_URL bypasses it and is used for migrations only.
# See docs/00-ANALYSIS.md R5 — Prisma on serverless exhausts connections without
# a pooler.
#
# On Supabase, use the *pooler* host for both. The direct host
# (db.<ref>.supabase.co) resolves to IPv6 only, which most home networks and
# some CI runners cannot route — the symptom is a bare P1001 that looks like a
# wrong password. Pooler form, note the `postgres.<ref>` username:
#
#   DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# 6543 is transaction mode (the app); 5432 is session mode, which migrations
# need. `pgbouncer=true` is what stops Prisma using prepared statements.
DATABASE_URL=postgresql://orbit:orbit_local_dev@localhost:5432/orbit?schema=public
DIRECT_URL=postgresql://orbit:orbit_local_dev@localhost:5432/orbit?schema=public

# ── Redis / queue ───────────────────────────────────────────────────────────
# Blocked question Q2: Upstash (public TLS, reachable from Vercel + ECS) vs
# ElastiCache (VPC-private). Code is agnostic — only this URL changes.
REDIS_URL=redis://localhost:6379

# ── Object storage (SRS §17, §51) ───────────────────────────────────────────
S3_REGION=eu-west-1
S3_BUCKET=orbit-media-dev
S3_ACCESS_KEY_ID=orbit_local
S3_SECRET_ACCESS_KEY=orbit_local_dev
# Set only for S3-compatible local storage (MinIO). Leave empty for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Optional CloudFront distribution for hot asset reads.
S3_PUBLIC_BASE_URL=
#
# Moving to real AWS S3: clear S3_ENDPOINT, set S3_FORCE_PATH_STYLE=false, and
# set S3_REGION to the bucket's actual region — a mismatch returns HTTP 301 with
# the real region in `x-amz-bucket-region`. The IAM user needs s3:PutObject,
# s3:GetObject and s3:DeleteObject on `arn:aws:s3:::<bucket>/*`; without them
# uploads fail with AccessDenied while everything else works, which reads like a
# bug in the app rather than a policy.

# ── Encryption (SRS §6) ─────────────────────────────────────────────────────
# AES-256-GCM key for social credentials at rest, base64-encoded 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this is sourced from AWS KMS / Secrets Manager, never a file.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Signing key for OAuth `state` and other short-lived signed tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATE_SIGNING_SECRET=

# ── Authentication — Firebase (SRS §51) ─────────────────────────────────────
# Setting the three FIREBASE_* server variables *switches the app to Firebase*,
# including locally — `selectIdentityProvider()` picks by presence. Leave them
# empty to keep the development sign-in; set them only alongside the three
# NEXT_PUBLIC_ ones below, or the browser has no way to obtain a token and
# sign-in silently becomes impossible.
#
# Also required, once: enable Authentication in the Firebase console and turn on
# the Google provider. The Admin SDK reports `auth/configuration-not-found`
# until that is done, which reads like a credential problem and is not one.

# Client SDK config, from Project settings → Your apps → Web app.
# Public by design: the API key identifies the project, it authorizes nothing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK service account (SERVER ONLY — never expose to the frontend).
# FIREBASE_PRIVATE_KEY keeps literal \n escapes and MUST be wrapped in double
# quotes: the parser only unescapes quoted values, so a stray character after
# the closing quote — a trailing comma from the service-account JSON is the
# usual one — leaves the key as raw text and OpenSSL fails with
# `DECODER routines::unsupported`.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Point the Admin SDK at the local emulator during development.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Social providers (SRS §7) ───────────────────────────────────────────────
# Facebook Pages is the only launch provider (SRS §51). Use a Meta *Test App*
# in development and staging; the reviewed app is production-only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ── AI (SRS §51) ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Billing (SRS §38) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability (SRS §33) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Email (SRS §22) ─────────────────────────────────────────────────────────
EMAIL_FROM=orbit@example.com
RESEND_API_KEY=
