# ─────────────────────────────────────────────────────────────────────────────
# AHN Orbit — environment configuration (SRS §45)
#
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every variable below is validated by a zod schema at process boot
# (packages/config) — a missing or malformed value fails the deploy, not the
# first request that needs it.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=development                       # development | staging | production
APP_URL=http://localhost:3000
LOG_LEVEL=debug                           # trace | debug | info | warn | error | fatal

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL goes through the connection pooler (PgBouncer / RDS Proxy /
# Neon pooled endpoint). DIRECT_URL bypasses it and is used for migrations only.
# See docs/00-ANALYSIS.md R5 — Prisma on serverless exhausts connections without
# a pooler. Blocked question Q3 decides the concrete host.
DATABASE_URL=postgresql://orbit:orbit_local_dev@localhost:5432/orbit?schema=public
DIRECT_URL=postgresql://orbit:orbit_local_dev@localhost:5432/orbit?schema=public

# ── Redis / queue ───────────────────────────────────────────────────────────
# Blocked question Q2: Upstash (public TLS, reachable from Vercel + ECS) vs
# ElastiCache (VPC-private). Code is agnostic — only this URL changes.
REDIS_URL=redis://localhost:6379

# ── Object storage (SRS §17, §51) ───────────────────────────────────────────
S3_REGION=eu-west-1
S3_BUCKET=orbit-media-dev
S3_ACCESS_KEY_ID=orbit_local
S3_SECRET_ACCESS_KEY=orbit_local_dev
# Set only for S3-compatible local storage (MinIO). Leave empty for real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# Optional CloudFront distribution for hot asset reads.
S3_PUBLIC_BASE_URL=

# ── Encryption (SRS §6) ─────────────────────────────────────────────────────
# AES-256-GCM key for social credentials at rest, base64-encoded 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this is sourced from AWS KMS / Secrets Manager, never a file.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1

# Signing key for OAuth `state` and other short-lived signed tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATE_SIGNING_SECRET=

# ── Authentication — Firebase (SRS §51) ─────────────────────────────────────
# Client SDK config (safe to expose to the browser; these are public by design).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Admin SDK service account (SERVER ONLY — never expose to the frontend).
# FIREBASE_PRIVATE_KEY keeps literal \n escapes; the config layer unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Point the Admin SDK at the local emulator during development.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Social providers (SRS §7) ───────────────────────────────────────────────
# Facebook Pages is the only launch provider (SRS §51). Use a Meta *Test App*
# in development and staging; the reviewed app is production-only.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ── AI (SRS §51) ────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Billing (SRS §38) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability (SRS §33) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Email (SRS §22) ─────────────────────────────────────────────────────────
EMAIL_FROM=orbit@example.com
RESEND_API_KEY=
