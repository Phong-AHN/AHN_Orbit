// ─────────────────────────────────────────────────────────────────────────────
// AHN Orbit — database schema
//
// Implements docs/DATABASE.md. Two rules hold everywhere:
//
//  1. Every tenant-owned model carries `organizationId`, even where it is
//     reachable through a parent. Isolation is then one indexed predicate,
//     identical on every table, and RLS policies are uniform (decision D-005).
//
//  2. Enums mirror @orbit/core. `packages/db/src/enum-drift.test.ts` parses this
//     file and fails if they diverge, so the mirroring cannot rot silently.
//
// Ids are UUIDv7, generated by `uuid_generate_v7()` (created in the baseline
// migration). Time-ordered so they index like a sequence without leaking row
// counts, and DB-side so application code cannot forget to supply one.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/.prisma/client, re-exported by @prisma/client).
  //
  // A custom output directory is imported by relative path, which webpack then
  // follows and bundles — and a bundled Prisma client makes @prisma/get-platform
  // glob the filesystem hunting for its query engine. The default location is
  // reachable as the bare specifier `@prisma/client`, which Next can treat as a
  // server-external package and leave alone.
  //
  // Prisma 7 will require an explicit output; revisit at that upgrade and add
  // the generated path to the bundler's externals at the same time.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════

enum OrganizationRole {
  OWNER
  ADMIN
  ACCOUNT_MANAGER
  CONTENT_CREATOR
  APPROVER
  CLIENT
}

enum WorkspaceRole {
  MANAGER
  CONTRIBUTOR
  APPROVER
  CLIENT_VIEWER
  CLIENT_APPROVER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  THREADS
  PINTEREST
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISABLED
  REVOKED
}

enum PostStatus {
  IDEA
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELED
}

enum VariantStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
  NEEDS_REVIEW
}

enum PostSource {
  MANUAL
  AI_IDEA
  REPURPOSE
}

enum ApprovalStage {
  INTERNAL
  CLIENT
}

enum ApprovalState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  CANCELED
}

enum ProductionStage {
  IDEA
  COPYWRITING
  DESIGN
  INTERNAL_REVIEW
  CLIENT_REVIEW
  SCHEDULING
}

enum ProductionTaskState {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum CommentVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum MediaKind {
  IMAGE
  VIDEO
  GIF
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

enum PublishingJobState {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  DEAD_LETTER
}

enum PublishingAttemptState {
  IN_FLIGHT
  SUCCEEDED
  FAILED
  RECONCILED
  INCONCLUSIVE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum ActorType {
  USER
  SYSTEM
  WORKER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ContentIdeaState {
  SUGGESTED
  ACCEPTED
  DISMISSED
  CONVERTED
}

// ═══════════════════════════════════════════════════════════════════════════
// Identity & tenancy
// ═══════════════════════════════════════════════════════════════════════════

/// App-owned identity record. Firebase Auth owns credentials — there is no
/// password column here, ever (decision D-004).
model User {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  firebaseUid  String    @unique
  /// Always stored lowercase; normalised on write.
  email        String    @unique
  name         String?
  avatarUrl    String?
  timezone     String    @default("UTC")
  locale       String    @default("en")
  /// The only role held outside a membership. Mirrored to a Firebase custom
  /// claim as a fast path, but always re-verified here before any privileged
  /// action (docs/RBAC.md §1 rule 2).
  isPlatformAdmin Boolean @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  organizationMemberships OrganizationMembership[] @relation("MembershipUser")
  invitedMemberships      OrganizationMembership[] @relation("MembershipInviter")
  workspaceMemberships    WorkspaceMembership[]
  brandAssignments        BrandAssignment[]
  createdPosts            Post[]                   @relation("PostCreator")
  assignedPosts           Post[]                   @relation("PostAssignee")
  productionTasks         ProductionTask[]
  requestedApprovals      Approval[]               @relation("ApprovalRequester")
  requestedReports        Report[]                 @relation("ReportRequester")
  decidedApprovals        Approval[]               @relation("ApprovalDecider")
  comments                Comment[]                @relation("CommentAuthor")
  resolvedComments        Comment[]                @relation("CommentResolver")
  uploadedMedia           MediaAsset[]
  connectedAccounts       SocialAccount[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  sentInvitations         Invitation[]
  aiUsage                 AIUsage[]
  updatedBrandVoices      BrandVoice[]
  generatedIdeas          ContentIdea[]

  @@index([email])
  @@index([isPlatformAdmin])
}

/// The tenant root. Every isolation predicate resolves to this id.
model Organization {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?
  timezone  String    @default("UTC")
  settings  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  memberships        OrganizationMembership[]
  workspaces         Workspace[]
  brands             Brand[]
  brandAssignments   BrandAssignment[]
  workspaceMembers   WorkspaceMembership[]
  socialAccounts     SocialAccount[]
  socialCredentials  SocialCredential[]
  posts              Post[]
  postVariants       PostVariant[]
  postMedia          PostMedia[]
  mediaAssets        MediaAsset[]
  mediaFolders       MediaFolder[]
  approvals          Approval[]
  productionTasks    ProductionTask[]
  comments           Comment[]
  queueSlots         QueueSlot[]
  publishingJobs     PublishingJob[]
  publishingAttempts PublishingAttempt[]
  postAnalytics      PostAnalytics[]
  analyticsSnapshots AnalyticsSnapshot[]
  brandVoices        BrandVoice[]
  contentIdeas       ContentIdea[]
  aiUsage            AIUsage[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  invitations        Invitation[]
  reports            Report[]
  subscription       Subscription?

  @@index([slug])
  @@index([deletedAt])
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?          @db.Uuid
  invitedAt      DateTime?        @db.Timestamptz(3)
  acceptedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
}

/// A client of the agency (assumption C1 — pending question Q1).
model Workspace {
  id                String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String          @db.Uuid
  name              String
  slug              String
  /// IANA zone, required. Scheduling resolves here (SRS §36, assumption C5).
  timezone          String
  clientCompanyName String?
  status            WorkspaceStatus @default(ACTIVE)
  /// Per-workspace toggle for whether clients may upload assets (RBAC.md O2).
  clientUploadsEnabled Boolean      @default(false)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?       @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  WorkspaceMembership[]
  brands       Brand[]
  mediaAssets  MediaAsset[]
  mediaFolders MediaFolder[]
  socialAccounts SocialAccount[]
  posts        Post[]
  queueSlots   QueueSlot[]
  contentIdeas ContentIdea[]
  reports      Report[]

  @@unique([organizationId, slug])
  /// Target for composite foreign keys from tenant-scoped children. Every
  /// reference to a Workspace carries the organizationId alongside it, so the
  /// database itself refuses a row that points across a tenant boundary.
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
}

model WorkspaceMembership {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String        @db.Uuid
  workspaceId    String        @db.Uuid
  userId         String        @db.Uuid
  role           WorkspaceRole
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([organizationId])
  /// Resolved on every request to build the principal's accessible workspaces.
  @@index([userId])
}

model Brand {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  name           String
  slug           String
  logoUrl        String?
  primaryColor   String?
  website        String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace         @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  assignments    BrandAssignment[]
  socialAccounts SocialAccount[]
  posts          Post[]
  mediaAssets    MediaAsset[]
  voice          BrandVoice?
  contentIdeas   ContentIdea[]
  aiUsage        AIUsage[]

  @@unique([workspaceId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([workspaceId, deletedAt])
}

/// Optional narrowing below workspace level. Absence of rows for a brand means
/// "workspace membership governs" — this table only ever narrows access.
model BrandAssignment {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @db.Uuid
  brandId        String   @db.Uuid
  userId         String   @db.Uuid
  canApprove     Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([organizationId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Social
// ═══════════════════════════════════════════════════════════════════════════

model SocialAccount {
  id              String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String              @db.Uuid
  workspaceId     String              @db.Uuid
  brandId         String              @db.Uuid
  platform        Platform
  /// The Page/account id at the provider.
  externalId      String
  handle          String?
  displayName     String
  avatarUrl       String?
  /// Provider-specific account kind, e.g. PAGE for Facebook.
  accountType     String?
  status          SocialAccountStatus @default(ACTIVE)
  /// Health is probe-driven, not expiry-driven — Page tokens die silently
  /// without expiring (docs/SOCIAL_PROVIDERS.md §4).
  healthCheckedAt DateTime?           @db.Timestamptz(3)
  healthError     String?
  scopes          String[]            @default([])
  connectedById   String?             @db.Uuid
  connectedAt     DateTime            @default(now()) @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  brand        Brand              @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Cascade)
  connectedBy  User?              @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  credential   SocialCredential?
  variants     PostVariant[]
  queueSlots   QueueSlot[]
  snapshots    AnalyticsSnapshot[]

  /// The same Page cannot be connected twice within one org, but different
  /// orgs may legitimately manage the same Page.
  @@unique([organizationId, platform, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([brandId, deletedAt])
  @@index([workspaceId])
}

/// Split from SocialAccount so credentials are never selected by accident.
/// AES-256-GCM; the key comes from KMS/Secrets Manager and `keyVersion` exists
/// so keys rotate without a migration (SRS §6).
model SocialCredential {
  id                    String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId        String    @db.Uuid
  socialAccountId       String    @unique @db.Uuid
  accessTokenCiphertext Bytes
  accessTokenIv         Bytes
  accessTokenAuthTag    Bytes
  refreshTokenCiphertext Bytes?
  refreshTokenIv        Bytes?
  refreshTokenAuthTag   Bytes?
  keyVersion            Int       @default(1)
  expiresAt             DateTime? @db.Timestamptz(3)
  refreshableUntil      DateTime? @db.Timestamptz(3)
  lastRefreshedAt       DateTime? @db.Timestamptz(3)
  scopes                String[]  @default([])
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, socialAccountId])
  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Content
// ═══════════════════════════════════════════════════════════════════════════

model Post {
  id               String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String     @db.Uuid
  workspaceId      String     @db.Uuid
  brandId          String     @db.Uuid
  title            String?
  /// Master copy. Per-account overrides live on PostVariant.
  body             String     @default("")
  status           PostStatus @default(DRAFT)
  createdById      String?    @db.Uuid
  assignedToId     String?    @db.Uuid
  approvalRequired Boolean    @default(true)
  /// Intent time. Per-variant times may differ.
  scheduledFor     DateTime?  @db.Timestamptz(3)
  /// Timezone the schedule was expressed in, resolved at schedule time.
  timezone         String?
  contentHash      String?
  source           PostSource @default(MANUAL)
  sourceIdeaId     String?    @db.Uuid
  publishedAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  brand        Brand            @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Cascade)
  createdBy    User?            @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("PostAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  variants     PostVariant[]
  media        PostMedia[]
  approvals    Approval[]
  tasks        ProductionTask[]
  comments     Comment[]
  // NoAction for the same reason as MediaAsset.brand — see the note there.
  sourceIdea   ContentIdea?     @relation("IdeaConvertedPost", fields: [organizationId, sourceIdeaId], references: [organizationId, id], onDelete: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId, status, scheduledFor])
  @@index([brandId, status])
  @@index([assignedToId, status])
  @@index([organizationId, deletedAt])
}

/// The unit of publishing: one per (post × social account) (decision D-006).
model PostVariant {
  id              String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String        @db.Uuid
  postId          String        @db.Uuid
  socialAccountId String        @db.Uuid
  platform        Platform
  body            String        @default("")
  firstComment    String?
  linkUrl         String?
  hashtags        String[]      @default([])
  mentions        Json          @default("[]")
  /// Provider-specific options, validated against the capability descriptor.
  platformOptions Json          @default("{}")
  status          VariantStatus @default(DRAFT)
  scheduledFor    DateTime?     @db.Timestamptz(3)

  /// Layer 2 of the idempotency strategy: the atomic publish claim
  /// (docs/ARCHITECTURE.md §5.2). Only the worker writes these.
  claimedAt       DateTime?     @db.Timestamptz(3)
  claimToken      String?

  externalPostId    String?
  externalPermalink String?
  publishedAt       DateTime?   @db.Timestamptz(3)
  lastError         Json?
  /// An opaque handle the provider recorded *before* a call whose outcome could
  /// be ambiguous, so reconciliation can ask the platform directly instead of
  /// inferring from a listing. Written and read only by the adapter that owns
  /// it; nothing else may interpret its shape.
  providerRef       Json?
  /// Reconciliation fingerprint (layer 4).
  contentHash       String?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?   @db.Timestamptz(3)

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post          Post            @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  socialAccount SocialAccount   @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)
  media         PostMedia[]
  jobs          PublishingJob[]
  analytics     PostAnalytics[]
  comments      Comment[]

  @@unique([postId, socialAccountId])
  @@unique([organizationId, id])
  /// Partial index (added in SQL) drives the 30s scheduler sweep.
  @@index([status, scheduledFor])
  @@index([socialAccountId, publishedAt])
  @@index([externalPostId])
  @@index([organizationId])
}

model PostMedia {
  id             String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String  @db.Uuid
  postId         String  @db.Uuid
  /// Null means the attachment applies to every variant of the post.
  postVariantId  String? @db.Uuid
  mediaAssetId   String  @db.Uuid
  position       Int     @default(0)
  altText        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post         @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  postVariant  PostVariant? @relation(fields: [organizationId, postVariantId], references: [organizationId, id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [organizationId, mediaAssetId], references: [organizationId, id], onDelete: Restrict)

  @@unique([postVariantId, mediaAssetId, position])
  @@index([postId, position])
  @@index([organizationId])
  @@index([mediaAssetId])
}

model MediaAsset {
  id               String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String      @db.Uuid
  workspaceId      String      @db.Uuid
  brandId          String?     @db.Uuid
  folderId         String?     @db.Uuid
  kind             MediaKind
  /// Derived from a generated id, never from a user-supplied filename.
  storageKey       String      @unique
  /// The *sniffed* type, not the declared one (SRS §17, decision D-013).
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  durationMs       Int?
  checksum         String?
  originalFilename String?
  tags             String[]    @default([])
  uploadedById     String?     @db.Uuid
  status           MediaStatus @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?   @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  // NoAction rather than SetNull: the foreign key is composite, and SET NULL
  // would try to null organizationId too, which is NOT NULL. NO ACTION is
  // checked at end-of-statement, so a cascading organization delete (which
  // removes parent and child together) still works, while an attempt to delete
  // a brand or folder that is still referenced is refused. Brands and folders
  // are soft-deleted in normal operation, so this is not a routine path.
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: NoAction)
  folder       MediaFolder? @relation(fields: [organizationId, folderId], references: [organizationId, id], onDelete: NoAction)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  postMedia    PostMedia[]

  @@unique([organizationId, id])
  @@index([organizationId, workspaceId, kind, createdAt])
  @@index([organizationId, status])
  @@index([folderId])
}

model MediaFolder {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  parentId       String?  @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  parent       MediaFolder?  @relation("FolderTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Cascade)
  children     MediaFolder[] @relation("FolderTree")
  assets       MediaAsset[]

  @@unique([workspaceId, parentId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Workflow
// ═══════════════════════════════════════════════════════════════════════════

model Approval {
  id             String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String        @db.Uuid
  postId         String        @db.Uuid
  stage          ApprovalStage
  state          ApprovalState @default(PENDING)
  requestedById  String?       @db.Uuid
  requestedAt    DateTime      @default(now()) @db.Timestamptz(3)
  decidedById    String?       @db.Uuid
  decidedAt      DateTime?     @db.Timestamptz(3)
  comment        String?
  /// Increments each time content is reopened and re-submitted.
  round          Int           @default(1)
  /// True when an internal user recorded a client's decision on their behalf
  /// (docs/RBAC.md note 5). Always audited with a reason.
  onBehalfOf     Boolean       @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post         @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  requestedBy  User?        @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy    User?        @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([postId, stage, state])
  @@index([organizationId, state])
}

/// The SRS §11 production pipeline — a separate axis from post status (D-007).
model ProductionTask {
  id             String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String              @db.Uuid
  postId         String              @db.Uuid
  stage          ProductionStage
  state          ProductionTaskState @default(TODO)
  assigneeId     String?             @db.Uuid
  dueAt          DateTime?           @db.Timestamptz(3)
  /// A post cannot leave DRAFT while a blocking task is open.
  blocking       Boolean             @default(false)
  startedAt      DateTime?           @db.Timestamptz(3)
  completedAt    DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post         @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([postId, stage])
  @@index([organizationId, state])
  @@index([assigneeId, state])
}

model Comment {
  id               String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId   String            @db.Uuid
  postId           String            @db.Uuid
  postVariantId    String?           @db.Uuid
  parentId         String?           @db.Uuid
  authorId         String?           @db.Uuid
  body             String
  mentionedUserIds String[]          @default([]) @db.Uuid
  /// Keeps internal chatter out of the client portal — enforced server-side in
  /// the portal service, never by a frontend filter (SRS §21).
  visibility       CommentVisibility @default(INTERNAL)
  resolvedAt       DateTime?         @db.Timestamptz(3)
  resolvedById     String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?         @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         Post         @relation(fields: [organizationId, postId], references: [organizationId, id], onDelete: Cascade)
  postVariant  PostVariant? @relation(fields: [organizationId, postVariantId], references: [organizationId, id], onDelete: Cascade)
  parent       Comment?     @relation("CommentThread", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Cascade)
  replies      Comment[]    @relation("CommentThread")
  author       User?        @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy   User?        @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([postId, createdAt])
  @@index([organizationId, visibility])
}

// ═══════════════════════════════════════════════════════════════════════════
// Scheduling & publishing
// ═══════════════════════════════════════════════════════════════════════════

/// Configurable posting slots (SRS §12). Stored as local wall-clock plus IANA
/// zone and resolved to UTC at enqueue time — storing UTC here would break
/// across DST (risk R9).
model QueueSlot {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String   @db.Uuid
  workspaceId     String   @db.Uuid
  /// Null applies the slot to every account in the workspace.
  socialAccountId String?  @db.Uuid
  dayOfWeek       Int
  /// "HH:MM" in the slot's own timezone.
  localTime       String
  timezone        String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, workspaceId, isActive])
}

/// The durable record of an intent to publish.
model PublishingJob {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String             @db.Uuid
  postVariantId  String             @db.Uuid
  /// Layer 1 of idempotency: derived from variant + schedule + content hash.
  idempotencyKey String
  scheduledFor   DateTime           @db.Timestamptz(3)
  state          PublishingJobState @default(PENDING)
  attemptCount   Int                @default(0)
  maxAttempts    Int                @default(4)
  nextAttemptAt  DateTime?          @db.Timestamptz(3)
  queueJobId     String?
  lastErrorCode  String?
  canceledAt     DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postVariant  PostVariant         @relation(fields: [organizationId, postVariantId], references: [organizationId, id], onDelete: Cascade)
  attempts     PublishingAttempt[]

  @@unique([postVariantId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([state, nextAttemptAt])
  @@index([organizationId, state])
}

/// One row per provider call, written *before* the call so an ambiguous
/// outcome is still recorded (SRS §14, docs/ARCHITECTURE.md §5.2).
model PublishingAttempt {
  id              String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId  String                 @db.Uuid
  publishingJobId String                 @db.Uuid
  attemptNumber   Int
  state           PublishingAttemptState @default(IN_FLIGHT)
  correlationId   String
  startedAt       DateTime               @default(now()) @db.Timestamptz(3)
  finishedAt      DateTime?              @db.Timestamptz(3)
  durationMs      Int?
  externalPostId  String?
  errorCode       String?
  errorMessage    String?
  errorRetryable  Boolean?
  /// Whitelisted safe fields only — never tokens or full headers (§14, §33).
  providerMeta    Json?
  httpStatus      Int?

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishingJob PublishingJob @relation(fields: [organizationId, publishingJobId], references: [organizationId, id], onDelete: Cascade)

  @@unique([publishingJobId, attemptNumber])
  @@index([organizationId, state])
}

// ═══════════════════════════════════════════════════════════════════════════
// Analytics
// ═══════════════════════════════════════════════════════════════════════════

/// `availability` records per-metric status so a metric the provider
/// deprecated is never stored or charted as 0 (SRS §18, decision D-010).
model PostAnalytics {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String   @db.Uuid
  postVariantId     String   @db.Uuid
  capturedAt        DateTime @db.Timestamptz(3)
  metrics           Json     @default("{}")
  availability      Json     @default("{}")
  providerApiVersion String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postVariant  PostVariant  @relation(fields: [organizationId, postVariantId], references: [organizationId, id], onDelete: Cascade)

  @@unique([postVariantId, capturedAt])
  @@index([organizationId])
}

model AnalyticsSnapshot {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId    String   @db.Uuid
  socialAccountId   String   @db.Uuid
  date              DateTime @db.Date
  metrics           Json     @default("{}")
  availability      Json     @default("{}")
  providerApiVersion String

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [organizationId, socialAccountId], references: [organizationId, id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@index([organizationId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AI
// ═══════════════════════════════════════════════════════════════════════════

/// Brand Brain (SRS §24). Loaded server-side after an RBAC check and injected
/// as delimited data, never as instructions (risk R11).
model BrandVoice {
  id                 String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId     String   @db.Uuid
  brandId            String   @unique @db.Uuid
  companyDescription String?
  productsServices   String?
  targetAudience     String?
  brandVoice         String?
  tone               String?
  preferredTerms     String[] @default([])
  bannedTerms        String[] @default([])
  ctas               String[] @default([])
  website            String?
  exampleContent     Json     @default("[]")
  socialInfo         Json     @default("{}")
  updatedById        String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, brandId])
  @@index([organizationId])
}

model ContentIdea {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String           @db.Uuid
  workspaceId    String           @db.Uuid
  brandId        String           @db.Uuid
  topic          String
  hook           String?
  platform       Platform?
  format         String?
  caption        String?
  cta            String?
  plannedFor     DateTime?        @db.Timestamptz(3)
  state          ContentIdeaState @default(SUGGESTED)
  generatedById  String?          @db.Uuid
  generationId   String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  brand          Brand        @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: Cascade)
  generatedBy    User?        @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  convertedPosts Post[]       @relation("IdeaConvertedPost")

  @@unique([organizationId, id])
  @@index([organizationId, state])
  @@index([brandId, plannedFor])
}

/// Drives plan limits (SRS §38) and per-org cost visibility.
model AIUsage {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  brandId        String?  @db.Uuid
  operation      String
  model          String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costEstimate   Decimal? @db.Decimal(12, 6)
  latencyMs      Int?
  succeeded      Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  // NoAction for the same reason as MediaAsset above.
  brand        Brand?       @relation(fields: [organizationId, brandId], references: [organizationId, id], onDelete: NoAction)

  @@index([organizationId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Platform
// ═══════════════════════════════════════════════════════════════════════════

model Notification {
  id             String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String              @db.Uuid
  userId         String              @db.Uuid
  type           String
  title          String
  body           String?
  resourceType   String?
  resourceId     String?             @db.Uuid
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?           @db.Timestamptz(3)
  emailedAt      DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([organizationId])
}

/// Append-only. The application role holds no UPDATE or DELETE grant, so the
/// log cannot drift from what actually happened (SRS §16, §31).
model AuditLog {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId   String?   @db.Uuid
  actorType     ActorType @default(USER)
  action        String
  resourceType  String
  resourceId    String?   @db.Uuid
  workspaceId   String?   @db.Uuid
  brandId       String?   @db.Uuid
  before        Json?
  after         Json?
  reason        String?
  ip            String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
}

/// A generated client report (SRS §19). Rendered by the worker, stored in S3,
/// handed back only as a short-lived signed URL — the storage key never leaves
/// the server.
model Report {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String       @db.Uuid
  /// Optional: a report may cover the whole organization or one client.
  workspaceId    String?      @db.Uuid
  status         ReportStatus @default(QUEUED)
  format         ReportFormat @default(CSV)
  /// What was asked for — range, filters, sections. Validated on the way in.
  parameters     Json         @default("{}")
  /// Where the rendered file lives. Server-side only; never serialised to a
  /// client, which receives a signed URL instead.
  storageKey     String?
  sizeBytes      Int?
  /// Set when the render fails. A code for us, a sentence for the person.
  failureCode    String?
  failureMessage String?
  /// After this the object is unreachable: the download route refuses, and the
  /// row is a record that the report existed rather than a way to fetch it.
  expiresAt      DateTime     @db.Timestamptz(3)
  requestedById  String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  requestedBy  User?        @relation("ReportRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
}

enum ReportStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

enum ReportFormat {
  CSV
}

model Subscription {
  id                   String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId       String             @unique @db.Uuid
  plan                 String             @default("trial")
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?          @db.Timestamptz(3)
  seats                Int                @default(5)
  /// { workspaces, socialAccounts, aiCreditsPerMonth, storageBytes }
  limits               Json               @default("{}")
  canceledAt           DateTime?          @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Only the *hash* of the invite token is stored — the token itself exists
/// only in the email that was sent.
model Invitation {
  id             String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           OrganizationRole
  workspaceIds   String[]         @default([]) @db.Uuid
  tokenHash      String           @unique
  expiresAt      DateTime         @db.Timestamptz(3)
  acceptedAt     DateTime?        @db.Timestamptz(3)
  revokedAt      DateTime?        @db.Timestamptz(3)
  invitedById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
}

/// Webhook idempotency (SRS §7). Not tenant-scoped: the tenant is resolved
/// through our own account mapping, never from the payload.
model WebhookEvent {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider        String
  externalEventId String
  signatureValid  Boolean
  payload         Json
  processedAt     DateTime? @db.Timestamptz(3)
  error           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([provider, externalEventId])
  @@index([processedAt])
}
